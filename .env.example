# Ví dụ tên biến môi trường. Spring Boot không tự nạp file .env này;
# khai báo trong hệ điều hành/IDE. Không commit giá trị thật.

# Google Login (OAuth2)
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP cho link khôi phục mật khẩu (không dùng JWT)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=
APP_PUBLIC_BASE_URL=
# Tối thiểu 32 byte ngẫu nhiên; giữ ngoài Git. Mọi link cũ sẽ hết hiệu lực khi đổi khóa.
APP_PASSWORD_RESET_SECRET=
