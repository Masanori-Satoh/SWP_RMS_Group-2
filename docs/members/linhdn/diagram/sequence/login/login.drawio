        <mxCell id="v-0189" value="RoleAuthorities.fromRoleName(account.getRole().getRoleName())&#10;RuntimeException (including missing / unsupported role)&#10;→ UsernameNotFoundException" style="fontFamily=Arial;fontSize=18;fontColor=#000000;shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacing=10;fontSize=17;" vertex="1" parent="1" sourceRefs="core/security/DatabaseUserDetailsService.java:43-51; core/security/RoleAuthorities.java:16-32">
          <mxGeometry x="1465" y="2695" width="890" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v-0223" value="AFTER THE LOGIN REDIRECT (a new request)&#10;AccountSessionGuardFilter.doFilterInternal(...) runs before AuthorizationFilter. For an authenticated non-anonymous principal, it calls findByUsernameIgnoreCase(authentication.getName()),&#10;recomputes RoleAuthorities.fromRoleName(...), and checks that the account exists, is Active and still has the session authority. A failed check calls logoutHandler.logout(...) and redirects to /login?session-expired.&#10;It is not drawn as an extra successful POST /login step: the authentication filter handles that POST and redirects. The target route still applies its own authorization rules.&#10;If the target is /dashboard and the authority is ROLE_CANDIDATE, DashboardController.dashboard(...) redirects to /portal/applications; internal dashboard details are outside this login interaction." style="fontFamily=Arial;fontSize=18;fontColor=#000000;shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacing=10;fontSize=17;" vertex="1" parent="1" sourceRefs="core/security/AccountSessionGuardFilter.java:28-63; core/config/SecurityConfig.java:177-178; dashboard/DashboardController.java:28-34">
          <mxGeometry x="65" y="3620" width="2370" height="180" as="geometry" />
        </mxCell>
