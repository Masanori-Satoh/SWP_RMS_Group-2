{
  "info": {
    "name": "RMS - Requisition system test",
    "description": "System test luồng Yêu cầu tuyển dụng qua HTTP (form + session + CSRF).\nChạy cả collection theo thứ tự bằng Collection Runner. Dữ liệu tạo ra được xóa ở thư mục 4.\nCần app chạy ở {{baseUrl}} với dữ liệu seed (hm_tuan, director, hr_lan).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Chạy sau MỌI request: trang HTML nào cũng chứa CSRF token",
          "// (trang đăng nhập: <input name=\"_csrf\" value=...>, trang nội bộ: <meta name=\"_csrf\" content=...>).",
          "// Lưu lại để các request POST sau gửi kèm _csrf={{csrf}}.",
          "const m = pm.response.text().match(/name=\"_csrf\" (?:value|content)=\"([^\"]+)\"/);",
          "if (m) pm.collectionVariables.set('csrf', m[1]);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "password",
      "value": "12345678"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "reqId",
      "value": ""
    },
    {
      "key": "startDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Chưa đăng nhập",
      "item": [
        {
          "name": "Chưa đăng nhập → chuyển về /login",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requisitions",
            "description": "Chạy request này trước tiên, khi cookie jar còn trống."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Chuyển tới trang đăng nhập\", () => pm.expect(pm.response.headers.get(\"Location\")).to.match(/\\/login$/));"
                ]
              }
            }
          ]
        }
      ]
    },
