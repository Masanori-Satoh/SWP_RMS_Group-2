# ===================================================================
# 1. Java & Build Outputs (Maven / Gradle)
# ===================================================================
target/
build/
bin/
out/
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Ngoại trừ file jar của Maven Wrapper để team không cần cài Maven thủ công
*.jar
!/.mvn/wrapper/maven-wrapper.jar

# ===================================================================
# 2. IntelliJ IDEA
# ===================================================================
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# ===================================================================
# 3. Visual Studio Code (VS Code)
# ===================================================================
# Bỏ qua cache và workspace cá nhân, giữ lại cấu hình dùng chung cho cả nhóm
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/.gitkeep
.vscode/.history/
*.code-workspace

# ===================================================================
# 4. Eclipse & NetBeans (Đề phòng thành viên trong nhóm dùng)
# ===================================================================
.settings/
.classpath
.project
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders
nbproject/
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ===================================================================
# 5. Logs & Temporary Files
# ===================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===================================================================
# 6. Database Files & Backups (MS SQL Server)
# ===================================================================
*.bak
*.mdf
*.ldf
*.sql.backup
database/backups/

# ===================================================================
# 7. Environment & Secrets (Không đưa thông tin nhạy cảm lên Git)
# ===================================================================
.env
.env.local
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml

# ===================================================================
# 8. Spring Boot / Maven Wrapper
# ===================================================================
# Maven Wrapper binary (không cần commit, tự download khi chạy)
.mvn/wrapper/maven-wrapper.jar

# Spring Boot restart trigger file (sinh ra khi dùng DevTools)
.reloadtrigger

# Thư mục upload file tạm (nếu có lưu file local khi dev)
uploads/
upload-temp/

# ===================================================================
# 9. Operating System Files
# ===================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
